DATABASE_URL=postgres://postgres:files@localhost:5432/files
# Generate with: openssl rand -base64 32
JWT_SECRET=
# Signs the local disk's download links. Generate with: openssl rand -hex 32
STORAGE_SIGNING_KEY=

# Optional, with their defaults:
# NODE_ENV=development
# PORT=3000
# Where clients reach the API: local download links point here. Change it with PORT.
# APP_URL=http://localhost:3000
# Browser origins allowed to call the API, comma-separated. None by default.
# CORS_ORIGINS=
# Where the local disk keeps the files.
# STORAGE_ROOT=storage

# S3, R2 or MinIO instead of the local folder (see the tutorial's "Use S3 in production"):
# STORAGE_DRIVER=s3
# S3_BUCKET=
# S3_REGION=
# For S3-compatible stores only, e.g. MinIO with S3_FORCE_PATH_STYLE=true:
# S3_ENDPOINT=
# S3_FORCE_PATH_STYLE=false
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# NestJS Observe: `npx @nestjs/observe link` writes these. Empty, the SDK sends nothing.
# OBSERVE_APP_KEY=
# OBSERVE_APP_SECRET=
